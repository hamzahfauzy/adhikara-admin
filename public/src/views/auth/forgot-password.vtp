<!-- Logo Header -->
<div class="d-flex align-items-center mb-4">
    <img src="/assets/images/adhikara-nusa-perkasa.png" alt="company-logo" style="width:150px;object-fit: contain;object-position: left;">
</div>

<!-- Login Card -->
<div class="card card-custom-shadow border-0 rounded-4 w-100" style="max-width: 440px;">
    <div class="card-body p-4 p-sm-5">
        
        <!-- Title -->
        <h4 class="text-center fw-bold mb-1" style="color: var(--text-dark);">Forgot Password</h4>
        <p class="text-center mb-4" style="color: var(--text-muted); font-size: 0.9rem;">Put your registered email for password reset link</p>

        <!-- Form -->
        <form action="" id="forgotForm">
            <!-- Email Input -->
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold small mb-1">Email</label>
                <input type="email" class="form-control rounded-3" id="email" placeholder="name@example.com" required>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-normal btn-success w-100 rounded-3 py-2 fw-semibold mb-2">Send Reset Password Link</button>
        </form>

        <center>
            <a href="/login" class="text-decoration-none fw-semibold small text-brand" router-link>Back to Login Page</a>
        </center>


    </div>
</div>