<!-- Header -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a href="/" router-link>Dashboard</a>
            </li>
            @component('breadcrumb', {
                breadcrumbs: [],
                title: 'Profile'
            })
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                Profile
            </h2>
            <p class="text-muted mb-0">
                here your account information detail
            </p>
        </div>
        <div class="d-flex gap-2">
            @component('vtp-action', {
                action: {
                    type: 'link',
                    route: '/profile/edit',
                    class: 'btn btn-normal btn-warning',
                    label: '<i class="bi bi-pencil me-2"></i> Edit Profile'
                },
                data: {}
            })
        </div>
    </div>
</div>

<div class="card detail-card">
    
    <div class="card-header detail-header d-flex justify-content-between align-items-center">
        <h5 class="detail-title">
            Detail Information
        </h5>
    </div>
    
    <div class="card-body detail-body">
        @for(const field of fields)
        <div class="row detail-row">
            <div class="col-sm-4 detail-label">{{field.label}}</div>
            <div class="col-sm-8 detail-value">{{field.value ? field.value(userData[field.key], userData) : userData[field.key]}}</div>
        </div>
        @endfor
    </div>

</div>